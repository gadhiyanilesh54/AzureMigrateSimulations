# vCenter discovery
VCENTER_HOST=vcenter.example.com
VCENTER_PORT=443
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=replace-me
VCENTER_DISABLE_SSL=true

# Azure context
AZURE_SUBSCRIPTION_ID=beccbce3-7faf-496f-b571-1fd2462704df
AZURE_RESOURCE_GROUP=rg-azure-migrate-simulations
AZURE_LOCATION=eastus

# Migration Copilot — Microsoft Foundry generative AI
AZURE_MIGRATE_CHAT_ENDPOINT=https://your-foundry-account.openai.azure.com
AZURE_MIGRATE_CHAT_DEPLOYMENT=gpt-6.1-sol
AZURE_MIGRATE_CHAT_API_VERSION=2024-12-01-preview

# Optional for local development only. Prefer DefaultAzureCredential or managed identity.
# AZURE_MIGRATE_CHAT_API_KEY=replace-me

# Optional web API protection
# MIGRATE_API_KEY=replace-me
